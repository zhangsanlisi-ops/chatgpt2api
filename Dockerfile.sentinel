# Rebuild the console so local Studio fixes remain present after container recreation.
FROM node:22-alpine AS web-build
WORKDIR /app/web-vue
COPY web-vue/package.json web-vue/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY VERSION /app/VERSION
COPY CHANGELOG.md /app/CHANGELOG.md
COPY web-vue ./
RUN npm run build

# Keep the backend hotfix layer on the exact locally installed release.
FROM ghcr.io/yukkcat/chatgpt2api:latest
RUN rm -rf /opt/chatgpt2api/web_dist
COPY --from=web-build /app/web-vue/dist /opt/chatgpt2api/web_dist
COPY services/openai_backend_api.py /opt/chatgpt2api/services/openai_backend_api.py
COPY services/account_service.py /opt/chatgpt2api/services/account_service.py
COPY services/image_failure.py /opt/chatgpt2api/services/image_failure.py
COPY services/sentinel_solver_client.py /opt/chatgpt2api/services/sentinel_solver_client.py
COPY utils/pow.py /opt/chatgpt2api/utils/pow.py
RUN python -c "import hashlib,pathlib; p=pathlib.Path('/opt/chatgpt2api'); names=('services/openai_backend_api.py','services/account_service.py','services/image_failure.py','services/sentinel_solver_client.py','utils/pow.py'); files=[p/n for n in names]+sorted(f for f in (p/'web_dist').rglob('*') if f.is_file()); digest=hashlib.sha256(b''.join(f.read_bytes() for f in files)).hexdigest()[:12]; (p/'VERSION').write_text('3.2.3-sentinel-'+digest+'\\n')"
